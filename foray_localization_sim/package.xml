  <version>0.1.0</version>
  <description>定位层仿真验证工具：真值里程计注入、仿真启动（不含 Gazebo 依赖）。</description>
  <maintainer email="dev@zqu-foray.cn">ZQU-Foray</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>foray_localization_bringup</exec_depend>
  <exec_depend>foray_localization_tools</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
